{
  "manifest_version": 3,
  "name": "Open via Menlo",
  "description": "Unofficial helper to open links via Menlo Security. Not affiliated with Menlo Security.",
  "version": "1.4.1",
  "permissions": ["contextMenus", "storage", "tabs"],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Open via Menlo",
    "default_icon": "icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/index.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "exclude_matches": ["*://safe.menlosecurity.com/*"]
    }
  ]
}
